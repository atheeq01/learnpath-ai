NODE_ENV=production
PORT=8080

# Required: use your existing Atlas connection string and JWT secret when updating.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/learnpath?retryWrites=true&w=majority
# At least 32 characters. Keep the existing secret to preserve active login tokens.
JWT_SECRET=

# Exact frontend origin: no /api suffix, path, or trailing slash.
CLIENT_URL=http://localhost:5173

# Required for AI recommendations; kept on the backend only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: override Node DNS servers if your default DNS cannot resolve Atlas.
# This affects Node DNS queries throughout the backend process.
MONGODB_DNS_SERVERS=
